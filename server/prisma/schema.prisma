generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  ADMIN
  RUNNER
}

enum ItemStatus {
  AVAILABLE
  UNAVAILABLE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AnnouncementType {
  STATUS
  GENERAL
}

enum PaymentMethod {
  FLUTTERWAVE
  BANK_TRANSFER
}

enum FoodCategory {
  RICE
  SWALLOW
  PROTEIN
  SIDES
  PASTA
  PASTRIES
  BUFFET
  DRINKS
}

enum Floor {
  GF
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
  F10
  F11
  F12
  F13
  F14
  F15
  F16
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String?
  emailVerified     Boolean            @default(false)
  verifyToken       String?            @unique
  verifyTokenExpiry DateTime?
  resetToken        String?            @unique
  resetTokenExpiry  DateTime?
  name              String?
  phone             String?
  role              Role               @default(STAFF)
  floor             Floor?
  officeNumber      String?
  telegramChatId    String?
  orders            Order[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("users")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model Vendor {
  id        String     @id @default(cuid())
  name      String
  items     MenuItem[]
  sides     Side[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("vendors")
}

model MenuItem {
  id                String         @id @default(cuid())
  name              String
  price             Decimal        @db.Decimal(10, 2)
  image             String?
  vendorId          String
  vendor            Vendor         @relation(fields: [vendorId], references: [id])
  totalStock        Int            @default(0)
  onlineStock       Int            @default(0)
  status            ItemStatus     @default(AVAILABLE)
  category          FoodCategory?
  requiresPackaging Boolean        @default(false)
  orderItems        OrderItem[]
  sides             MenuItemSide[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("menu_items")
}

// A side a vendor can offer (e.g. plantain, coleslaw). Independent of any
// one dish — MenuItemSide says which sides a given dish actually offers.
model Side {
  id        String          @id @default(cuid())
  name      String
  price     Decimal         @default(0) @db.Decimal(10, 2)
  vendorId  String
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  status    ItemStatus      @default(AVAILABLE)
  menuItems MenuItemSide[]
  orderUses OrderItemSide[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("sides")
}

// Join: which sides a given MenuItem offers.
model MenuItemSide {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sideId     String
  side       Side     @relation(fields: [sideId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([menuItemId, sideId])
  @@map("menu_item_sides")
}

model Order {
  id                String        @id @default(cuid())
  reference         String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  items             OrderItem[]
  deliveryFee       Decimal       @db.Decimal(10, 2)
  packagingFee      Decimal       @default(0) @db.Decimal(10, 2)
  status            OrderStatus   @default(PENDING)
  floor             Floor
  officeNumber      String
  phone             String
  paymentMethod     PaymentMethod @default(FLUTTERWAVE)
  paymentRef        String?
  transferReference String?
  paid              Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  menuItemId        String
  menuItem          MenuItem        @relation(fields: [menuItemId], references: [id])
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  requiresPackaging Boolean         @default(false)
  sides             OrderItemSide[]

  @@map("order_items")
}

// What was actually picked for one OrderItem, with the side's name and price
// snapshotted at order time (same reasoning as OrderItem.unitPrice) so
// renaming/repricing/retiring a Side later never rewrites order history.
model OrderItemSide {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  sideId      String
  side        Side      @relation(fields: [sideId], references: [id])
  name        String
  price       Decimal   @db.Decimal(10, 2)

  @@map("order_item_sides")
}

model Announcement {
  id        String           @id @default(cuid())
  type      AnnouncementType
  message   String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("announcements")
}

// Singleton row (id is always "singleton") holding admin-editable app settings.
// Orders snapshot the fee at creation time (Order.packagingFee), so changing
// this here never affects past orders — only ones placed after the change.
model Settings {
  id           String   @id @default("singleton")
  packagingFee Int      @default(50)
  updatedAt    DateTime @updatedAt

  @@map("settings")
}
